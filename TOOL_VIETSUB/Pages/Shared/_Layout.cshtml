<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#070b13" />
    <title>@ViewData["Title"] · TOOL VIETSUB SERVER</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="server-header">
        <a class="server-brand" asp-page="/Index" aria-label="TOOL VIETSUB Server">
            <span class="server-mark">▣</span>
            <span><strong>TOOL VIETSUB</strong><small>SERVER</small></span>
        </a>
        <nav aria-label="Điều hướng chính">
            <a asp-page="/Index">Tổng quan</a>
            @if (User.Identity?.IsAuthenticated == true && User.IsInRole("ADMIN"))
            {
                <a asp-page="/Admin/Subscriptions">Nâng cấp tài khoản</a>
            }
            <a href="/openapi/v1.json">OpenAPI</a>
        </nav>
        <div class="server-header-actions">
            <span class="server-status"><i></i> API V1 sẵn sàng</span>
            @if (User.Identity?.IsAuthenticated == true && User.IsInRole("ADMIN"))
            {
                <form method="post" asp-page="/Admin/Logout"><button type="submit">Đăng xuất</button></form>
            }
            else
            {
                <a class="admin-login-link" asp-page="/Admin/Login">Quản trị</a>
            }
        </div>
    </header>

    <main class="server-main">
        @RenderBody()
    </main>

    <footer class="server-footer">
        <span>TOOL VIETSUB SERVER</span>
        <span>ASP.NET Core · SQL Server · HTTPS API</span>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
