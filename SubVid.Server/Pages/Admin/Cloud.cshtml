@page
@model SubVid.Server.Pages.Admin.CloudModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Cloud API";
    var hasModelErrors = ViewData.ModelState.Values.Any(entry => entry.Errors.Count > 0);
    var firstLedger = Model.Ledger.TotalCount == 0 ? 0 : ((Model.Ledger.Page - 1) * Model.Ledger.PageSize) + 1;
    var lastLedger = Math.Min(Model.Ledger.Page * Model.Ledger.PageSize, Model.Ledger.TotalCount);
}

<section class="admin-light-heading">
    <div>
        <span>QUẢN LÝ CLOUD API</span>
        <h1>Kiểm soát key và token tại một nơi.</h1>
        <p>Server lưu key đã mã hóa, cấp quyền theo hạn mức và ghi ledger. Nội dung dịch vẫn được App xử lý trực tiếp.</p>
    </div>
    <div class="admin-light-period" aria-label="Chu kỳ hạn mức hiện tại">
        <small>CHU KỲ HIỆN TẠI</small>
        <strong>@Model.Overview.PeriodStartsAtUtc.ToString("dd/MM") — @Model.Overview.PeriodEndsAtUtc.AddDays(-1).ToString("dd/MM/yyyy")</strong>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage) || !string.IsNullOrWhiteSpace(Model.ProbeMessage) || hasModelErrors)
{
    var isSuccess = !string.IsNullOrWhiteSpace(Model.SuccessMessage)
        || Model.ProbeMessageKind == "success";
    var title = !string.IsNullOrWhiteSpace(Model.SuccessMessage)
        ? "Đã hoàn tất"
        : !string.IsNullOrWhiteSpace(Model.ProbeMessage)
            ? "Kiểm tra kết nối"
            : "Không thể hoàn tất thao tác";
    var message = !string.IsNullOrWhiteSpace(Model.SuccessMessage)
        ? Model.SuccessMessage
        : Model.ProbeMessage;

    <dialog class="admin-notification-modal" data-notification-modal data-modal-auto="true" aria-labelledby="cloud-notification-title">
        <div class="admin-notification-modal__surface @(isSuccess ? "is-success" : "is-error")">
            <span class="admin-notification-modal__icon"><svg class="admin-icon"><use href="@(isSuccess ? "#admin-icon-check" : "#admin-icon-alert")"></use></svg></span>
            <div class="admin-notification-modal__content">
                <small>@(isSuccess ? "THÔNG BÁO HỆ THỐNG" : "CẦN KIỂM TRA")</small>
                <h2 id="cloud-notification-title">@title</h2>
                @if (!string.IsNullOrWhiteSpace(message))
                {
                    <p>@message</p>
                }
                @if (hasModelErrors)
                {
                    <div asp-validation-summary="ModelOnly" class="admin-notification-modal__errors"></div>
                }
            </div>
            <button type="button" data-notification-modal-close aria-label="Đóng thông báo"><svg class="admin-icon"><use href="#admin-icon-close"></use></svg></button>
            <div class="admin-notification-modal__actions"><button type="button" data-notification-modal-close>Đã hiểu</button></div>
        </div>
    </dialog>
}

@if (Model.Overview.ActiveCredentials == 0 || Model.Overview.ConfiguredUsers == 0)
{
    <section class="admin-setup-banner" aria-label="Các bước cần hoàn tất">
        <div><span><svg class="admin-icon"><use href="#admin-icon-alert"></use></svg></span><div><strong>Cloud API chưa sẵn sàng</strong><p>Hoàn thành hai bước dưới đây trước khi chạy dịch thật trên App.</p></div></div>
        <ol>
            <li class="@(Model.Overview.ActiveCredentials > 0 ? "is-done" : null)"><span>1</span><div><strong>Thêm API key</strong><small>@(Model.Overview.ActiveCredentials > 0 ? "Đã có key hoạt động" : "Kiểm tra rồi lưu key mới")</small></div></li>
            <li class="@(Model.Overview.ConfiguredUsers > 0 ? "is-done" : null)"><span>2</span><div><strong>Cấp token cho user</strong><small>@(Model.Overview.ConfiguredUsers > 0 ? "Đã có user được cấp" : "Quota mặc định đang bằng 0")</small></div></li>
        </ol>
    </section>
}

<section class="admin-light-stats" aria-label="Tổng quan Cloud API">
    <article><span class="is-blue"><svg class="admin-icon"><use href="#admin-icon-key"></use></svg></span><div><small>KEY ĐANG BẬT</small><strong>@Model.Overview.ActiveCredentials</strong><em>key riêng và key pool</em></div></article>
    <article><span class="is-violet"><svg class="admin-icon"><use href="#admin-icon-users"></use></svg></span><div><small>USER CÓ QUOTA</small><strong>@Model.Overview.ConfiguredUsers</strong><em>hạn mức lớn hơn 0</em></div></article>
    <article><span class="is-emerald"><svg class="admin-icon"><use href="#admin-icon-tokens"></use></svg></span><div><small>TOKEN ĐÃ DÙNG</small><strong>@Model.Overview.UsedTokens.ToString("N0")</strong><em>trong chu kỳ hiện tại</em></div></article>
    <article><span class="is-amber"><svg class="admin-icon"><use href="#admin-icon-clock"></use></svg></span><div><small>ĐANG GIỮ CHỖ</small><strong>@Model.Overview.HeldTokens.ToString("N0")</strong><em>@Model.Overview.RequestsToday request hôm nay</em></div></article>
</section>

<section class="admin-light-grid">
    <article id="cloud-key-editor" class="admin-light-card admin-key-card">
        <header>
            <div><span class="admin-card-icon is-blue"><svg class="admin-icon"><use href="#admin-icon-key"></use></svg></span><div><h2>Kho API key</h2><p>Key riêng được ưu tiên trước key pool; giá trị bí mật không hiển thị lại sau khi lưu.</p></div></div>
            <a class="admin-key-vault-link" asp-page="/Admin/CloudKeys"><svg class="admin-icon"><use href="#admin-icon-key"></use></svg><span>Kho Key</span></a>
        </header>
        <form method="post" asp-page-handler="SaveCredential" class="admin-light-form admin-credential-form" autocomplete="off" data-credential-form>
            <input asp-for="CredentialId" type="hidden" />
            <input asp-for="Email" type="hidden" />
            <input asp-for="ReturnToVault" type="hidden" />
            <label>
                <span>Nhà cung cấp</span>
                <select asp-for="ProviderCode" class="admin-provider-native" data-provider-select data-testid="provider-select" tabindex="-1" aria-hidden="true">
                    <option value="openai">OpenAI</option>
                    <option value="groq">Groq</option>
                    <option value="deepseek">DeepSeek</option>
                    <option value="gemini">Gemini</option>
                </select>
                <button class="admin-provider-trigger" type="button" data-provider-trigger aria-haspopup="dialog" aria-controls="admin-provider-modal">
                    <span data-provider-label>@Model.ProviderCode</span>
                    <svg class="admin-icon" aria-hidden="true"><use href="#admin-icon-plans"></use></svg>
                </button>
                <small class="admin-field-error"><span asp-validation-for="ProviderCode"></span></small>
            </label>
            <label>
                <span>Tên nhận diện</span>
                <input asp-for="CredentialName" data-credential-name placeholder="OpenAI pool chính" />
                <small class="admin-field-error"><span asp-validation-for="CredentialName"></span></small>
            </label>
            <label class="is-wide">
                <span>API key @(Model.CredentialId is null ? "" : "· để trống nếu không thay đổi")</span>
                <div class="admin-secret-field">
                    <input asp-for="ApiKey" type="password" placeholder="Dán key mới tại đây" autocomplete="new-password" data-api-key data-testid="api-key-input" />
                    <button type="button" data-secret-toggle aria-label="Hiện API key" aria-pressed="false">Hiện</button>
                </div>
                <small class="admin-field-help">Chỉ gửi tới endpoint xác thực của provider khi bạn bấm kiểm tra. Server không ghi key vào log.</small>
                <small class="admin-field-error"><span asp-validation-for="ApiKey"></span></small>
            </label>
            <label>
                <span>Chế độ phân bổ</span>
                <select asp-for="AllocationMode" data-allocation-mode>
                    <option value="UNASSIGNED">Chưa phân bổ</option>
                    <option value="SHARED">Dùng chung theo pool</option>
                    <option value="DEDICATED">Dành riêng cho người dùng</option>
                </select>
                <small class="admin-field-help">Key chưa phân bổ được giữ trong kho và không được cấp cho request.</small>
                <small class="admin-field-error"><span asp-validation-for="AllocationMode"></span></small>
            </label>
            <label data-allocation-pool>
                <span>Pool dùng chung</span>
                <select asp-for="PoolId">
                    <option value="">Chọn pool theo gói</option>
                    @foreach (var pool in Model.Pools)
                    {
                        <option value="@pool.PoolId" data-pool-provider="@pool.ProviderCode">@pool.DisplayName · @string.Join(", ", pool.PlanCodes)</option>
                    }
                </select>
                <small class="admin-field-help">Chỉ người dùng thuộc gói liên kết với pool mới được sử dụng.</small>
                <small class="admin-field-error"><span asp-validation-for="PoolId"></span></small>
            </label>
            <label data-allocation-user>
                <span>Email người dùng</span>
                <input asp-for="AssignedEmail" type="email" placeholder="user@example.com" />
                <small class="admin-field-help">Key riêng chỉ được cấp cho đúng tài khoản này.</small>
                <small class="admin-field-error"><span asp-validation-for="AssignedEmail"></span></small>
            </label>
            <label>
                <span>Độ ưu tiên</span>
                <input asp-for="Priority" type="number" min="0" max="10000" />
                <small class="admin-field-help">Số nhỏ hơn sẽ được chọn trước.</small>
                <small class="admin-field-error"><span asp-validation-for="Priority"></span></small>
            </label>
            <output class="admin-probe-result is-idle is-wide" data-probe-result aria-live="polite">
                <span><svg class="admin-icon"><use href="#admin-icon-info"></use></svg></span><div><strong>Chưa kiểm tra kết nối</strong><small>Kiểm tra chỉ xác thực key, không tạo nội dung và không dùng token model.</small></div>
            </output>
            <div class="admin-form-actions is-wide">
                @if (Model.CredentialId is not null)
                {
                    @if (Model.ReturnToVault)
                    {
                        <a asp-page="/Admin/CloudKeys">Hủy chỉnh sửa</a>
                    }
                    else
                    {
                        <a asp-page="/Admin/Cloud" asp-route-email="@Model.Email">Hủy chỉnh sửa</a>
                    }
                }
                <button class="admin-secondary-button" type="button" data-credential-probe data-testid="probe-key-button"><svg class="admin-icon"><use href="#admin-icon-refresh"></use></svg><span>Kiểm tra key</span></button>
                <button type="submit" data-testid="save-key-button"><span>@(Model.CredentialId is null ? "Lưu API key" : "Lưu thay đổi")</span><svg class="admin-icon"><use href="#admin-icon-arrow-right"></use></svg></button>
            </div>
        </form>
        <dialog id="admin-provider-modal" class="admin-provider-modal" data-provider-modal aria-label="Chọn nhà cung cấp AI">
            <div class="admin-provider-modal__surface">
                <header>
                    <div><small>NHÀ CUNG CẤP AI</small><h2>Chọn nhà cung cấp</h2><p>Chọn dịch vụ sẽ dùng để xác thực API key.</p></div>
                    <button type="button" data-provider-modal-close aria-label="Đóng"><svg class="admin-icon"><use href="#admin-icon-close"></use></svg></button>
                </header>
                <div class="admin-provider-options" role="listbox" aria-label="Danh sách nhà cung cấp">
                    <button type="button" data-provider-option data-provider-code="openai" role="option"><span>O</span><strong>OpenAI</strong><small>GPT và API tương thích</small></button>
                    <button type="button" data-provider-option data-provider-code="groq" role="option"><span>G</span><strong>Groq</strong><small>Suy luận tốc độ cao</small></button>
                    <button type="button" data-provider-option data-provider-code="deepseek" role="option"><span>D</span><strong>DeepSeek</strong><small>Mô hình DeepSeek</small></button>
                    <button type="button" data-provider-option data-provider-code="gemini" role="option"><span>G</span><strong>Gemini</strong><small>Google AI Studio</small></button>
                </div>
            </div>
        </dialog>
    </article>

    <article class="admin-light-card admin-quota-card">
        <header><div><span class="admin-card-icon is-violet"><svg class="admin-icon"><use href="#admin-icon-users"></use></svg></span><div><h2>Cấp token theo user</h2><p>Không có cấu hình nghĩa là hạn mức Cloud bằng 0.</p></div></div></header>
        <form method="post" asp-page-handler="Search" class="admin-user-search" novalidate>
            <label>
                <span>Email người dùng</span>
                <span class="admin-search-combo"><input asp-for="Email" type="email" placeholder="user@example.com" aria-label="Email người dùng" /><button type="submit">Tìm tài khoản</button></span>
                <small class="admin-field-error"><span asp-validation-for="Email"></span></small>
            </label>
        </form>
        @if (Model.Account is null)
        {
            <div class="admin-empty-state admin-user-empty"><span><svg class="admin-icon"><use href="#admin-icon-search"></use></svg></span><strong>Chưa chọn tài khoản</strong><p>Tìm theo email để xem mức sử dụng và điều chỉnh token.</p></div>
        }
        else
        {
            <div class="admin-user-profile">
                <span>@Model.Account.DisplayName[..1].ToUpperInvariant()</span>
                <div><strong>@Model.Account.DisplayName</strong><small>@Model.Account.Email</small></div>
                <em>@(Model.Account.Status == "ACTIVE" ? "Đang hoạt động" : Model.Account.Status)</em>
            </div>
            <a class="admin-account-detail-link" asp-page="/Admin/Users/Detail" asp-route-id="@Model.Account.UserId">Mở hồ sơ người dùng <svg class="admin-icon"><use href="#admin-icon-arrow-right"></use></svg></a>
            <div class="admin-quota-progress">
                @{ var percent = Model.Account.MonthlyLimit <= 0 ? 0 : Math.Min(100, (Model.Account.UsedUnits + Model.Account.HeldUnits) * 100d / Model.Account.MonthlyLimit); }
                <div><span>Đã dùng + đang giữ</span><strong>@((Model.Account.UsedUnits + Model.Account.HeldUnits).ToString("N0")) / @Model.Account.MonthlyLimit.ToString("N0")</strong></div>
                <i><span style="width: @percent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span></i>
                <div><small>Đã dùng @Model.Account.UsedUnits.ToString("N0")</small><small>Đang giữ @Model.Account.HeldUnits.ToString("N0")</small><small>Còn lại @Model.Account.RemainingUnits.ToString("N0")</small></div>
            </div>
            <form method="post" asp-page-handler="SaveQuota" class="admin-quota-form">
                <input asp-for="Email" type="hidden" />
                <label><span>Token dịch mỗi tháng</span><input asp-for="MonthlyLlmTokens" type="number" min="0" max="1000000000000" step="1000" /><small class="admin-field-error"><span asp-validation-for="MonthlyLlmTokens"></span></small></label>
                <div class="admin-quota-presets" aria-label="Mức token gợi ý"><button type="button" data-quota="100000">100K</button><button type="button" data-quota="500000">500K</button><button type="button" data-quota="2000000">2M</button><button type="button" data-quota="10000000">10M</button></div>
                <button class="admin-primary-button" type="submit"><span>Lưu hạn mức token</span><svg class="admin-icon"><use href="#admin-icon-arrow-right"></use></svg></button>
            </form>
            <form method="post" asp-page-handler="ResetQuota" class="admin-quota-reset-form">
                <input asp-for="Email" type="hidden" />
                <span>@(Model.Account.CustomMonthlyLimit is null ? "Đang dùng hạn mức theo gói." : $"Đang ghi đè theo người dùng: {Model.Account.CustomMonthlyLimit:N0} token.")</span>
                <button type="submit" disabled="@(Model.Account.CustomMonthlyLimit is null ? "disabled" : null)">Dùng hạn mức của gói</button>
            </form>
        }
    </article>
</section>

<section id="usage-ledger" class="admin-light-card admin-ledger-card">
    <header><div><span class="admin-card-icon is-emerald"><svg class="admin-icon"><use href="#admin-icon-activity"></use></svg></span><div><h2>Usage ledger gần đây</h2><p>Mỗi reservation chỉ được chốt một lần; không lưu prompt hoặc kết quả dịch.</p></div></div><span class="admin-count-pill">@Model.Ledger.TotalCount.ToString("N0") bản ghi</span></header>
    <div class="admin-table-wrap">
        <table class="admin-ledger-table">
            <thead><tr><th>Thời gian</th><th>Người dùng</th><th>Provider / model</th><th>Credential</th><th>Input</th><th>Output</th><th>Tổng token</th><th>Request</th></tr></thead>
            <tbody>
            @if (Model.Ledger.Items.Count == 0)
            {
                <tr><td colspan="8" class="admin-table-empty">Chưa có usage Cloud được chốt.</td></tr>
            }
            @foreach (var item in Model.Ledger.Items)
            {
                <tr>
                    <td><strong>@item.OccurredAtUtc.ToLocalTime().ToString("dd/MM HH:mm")</strong></td>
                    <td>@item.UserEmail</td>
                    <td><strong>@item.ProviderCode</strong><small>@item.ModelId</small></td>
                    <td>@item.CredentialName</td>
                    <td>@item.InputUnits.ToString("N0")</td>
                    <td>@item.OutputUnits.ToString("N0")</td>
                    <td><strong class="admin-token-value">@item.TotalUnits.ToString("N0")</strong></td>
                    <td><span class="admin-request-badge">@item.ApiRequests API · @item.RetryRequests retry</span></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <footer class="admin-user-pagination admin-ledger-pagination">
        <span>Hiển thị @firstLedger–@lastLedger trong @Model.Ledger.TotalCount.ToString("N0") bản ghi</span>
        <div>
            <a class="@(Model.Ledger.Page <= 1 ? "is-disabled" : null)" asp-page="/Admin/Cloud" asp-route-email="@Model.Email" asp-route-editCredentialId="@Model.EditCredentialId" asp-route-ledgerPage="@(Model.Ledger.Page - 1)" asp-fragment="usage-ledger">Trước</a>
            <strong>Trang @Model.Ledger.Page / @Model.Ledger.TotalPages</strong>
            <a class="@(Model.Ledger.Page >= Model.Ledger.TotalPages ? "is-disabled" : null)" asp-page="/Admin/Cloud" asp-route-email="@Model.Email" asp-route-editCredentialId="@Model.EditCredentialId" asp-route-ledgerPage="@(Model.Ledger.Page + 1)" asp-fragment="usage-ledger">Sau</a>
        </div>
    </footer>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const notificationModal = document.querySelector('[data-notification-modal]');
            if (notificationModal instanceof HTMLDialogElement) {
                document.querySelectorAll('[data-notification-modal-close]').forEach((button) => {
                    button.addEventListener('click', () => notificationModal.close());
                });
                notificationModal.addEventListener('click', (event) => {
                    if (event.target === notificationModal) notificationModal.close();
                });
                if (notificationModal.dataset.modalAuto === 'true') {
                    requestAnimationFrame(() => notificationModal.showModal());
                }
            }

            document.querySelectorAll('[data-quota]').forEach((button) => {
                button.addEventListener('click', () => {
                    const input = document.getElementById('MonthlyLlmTokens');
                    if (input) input.value = button.getAttribute('data-quota');
                });
            });

            document.querySelectorAll('[data-confirm]').forEach((button) => {
                button.addEventListener('click', (event) => {
                    if (!window.confirm(button.getAttribute('data-confirm'))) event.preventDefault();
                });
            });

            const form = document.querySelector('[data-credential-form]');
            if (!form) return;
            const provider = form.querySelector('[data-provider-select]');
            const providerTrigger = form.querySelector('[data-provider-trigger]');
            const providerLabel = form.querySelector('[data-provider-label]');
            const providerModal = document.querySelector('[data-provider-modal]');
            const providerOptions = document.querySelectorAll('[data-provider-option]');
            const nameInput = form.querySelector('[data-credential-name]');
            const keyInput = form.querySelector('[data-api-key]');
            const toggle = form.querySelector('[data-secret-toggle]');
            const probeButton = form.querySelector('[data-credential-probe]');
            const probeResult = form.querySelector('[data-probe-result]');
            const allocationMode = form.querySelector('[data-allocation-mode]');
            const poolField = form.querySelector('[data-allocation-pool]');
            const poolSelect = poolField?.querySelector('select');
            const userField = form.querySelector('[data-allocation-user]');
            const assignedEmail = userField?.querySelector('input');
            const placeholders = { openai: 'OpenAI pool chính', groq: 'Groq pool chính', deepseek: 'DeepSeek pool chính', gemini: 'Gemini pool chính' };

            const syncProviderUi = () => {
                if (!provider) return;
                const selected = provider.options[provider.selectedIndex];
                if (providerLabel && selected) providerLabel.textContent = selected.textContent || provider.value;
                providerOptions.forEach((option) => {
                    const isSelected = option.getAttribute('data-provider-code') === provider.value;
                    option.classList.toggle('is-selected', isSelected);
                    option.setAttribute('aria-selected', String(isSelected));
                });
            };

            const syncAllocationUi = () => {
                const mode = allocationMode?.value || 'UNASSIGNED';
                const usesPool = mode === 'SHARED';
                const usesUser = mode === 'DEDICATED';
                if (poolField) poolField.hidden = !usesPool;
                if (poolSelect) {
                    poolSelect.disabled = !usesPool;
                    Array.from(poolSelect.options).forEach((option) => {
                        if (!option.value) return;
                        const matches = option.dataset.poolProvider === provider?.value;
                        option.hidden = !matches;
                        option.disabled = !matches;
                    });
                    const selected = poolSelect.options[poolSelect.selectedIndex];
                    if (usesPool && selected?.dataset.poolProvider !== provider?.value) poolSelect.value = '';
                }
                if (userField) userField.hidden = !usesUser;
                if (assignedEmail) assignedEmail.disabled = !usesUser;
            };

            provider?.addEventListener('change', () => {
                if (nameInput && !nameInput.value) nameInput.placeholder = placeholders[provider.value] || 'Key pool chính';
                probeResult.className = 'admin-probe-result is-idle is-wide';
                probeResult.innerHTML = '<span><svg class="admin-icon"><use href="#admin-icon-info"></use></svg></span><div><strong>Chưa kiểm tra kết nối</strong><small>Provider đã thay đổi; hãy kiểm tra lại trước khi lưu.</small></div>';
            });

            provider?.addEventListener('change', syncAllocationUi);
            allocationMode?.addEventListener('change', syncAllocationUi);

            providerTrigger?.addEventListener('click', () => {
                if (typeof providerModal?.showModal === 'function') providerModal.showModal();
            });
            document.querySelectorAll('[data-provider-modal-close]').forEach((button) => {
                button.addEventListener('click', () => providerModal?.close());
            });
            providerModal?.addEventListener('click', (event) => {
                if (event.target === providerModal) providerModal.close();
            });
            providerOptions.forEach((option) => {
                option.addEventListener('click', () => {
                    if (!provider) return;
                    provider.value = option.getAttribute('data-provider-code') || provider.value;
                    provider.dispatchEvent(new Event('change', { bubbles: true }));
                    syncProviderUi();
                    providerModal?.close();
                    providerTrigger?.focus({ preventScroll: true });
                });
            });
            syncProviderUi();
            syncAllocationUi();

            toggle?.addEventListener('click', () => {
                const visible = keyInput.type === 'text';
                keyInput.type = visible ? 'password' : 'text';
                toggle.textContent = visible ? 'Hiện' : 'Ẩn';
                toggle.setAttribute('aria-label', visible ? 'Hiện API key' : 'Ẩn API key');
                toggle.setAttribute('aria-pressed', String(!visible));
                keyInput.focus({ preventScroll: true });
            });

            const showProbe = (kind, title, detail) => {
                probeResult.className = `admin-probe-result is-${kind} is-wide`;
                const icon = kind === 'success' ? 'admin-icon-check' : kind === 'loading' ? 'admin-icon-refresh' : 'admin-icon-alert';
                probeResult.innerHTML = `<span><svg class="admin-icon"><use href="#${icon}"></use></svg></span><div><strong></strong><small></small></div>`;
                probeResult.querySelector('strong').textContent = title;
                probeResult.querySelector('small').textContent = detail;
            };

            probeButton?.addEventListener('click', async () => {
                if (!keyInput.value.trim()) {
                    showProbe('error', 'Chưa có API key', 'Hãy dán key mới trước khi kiểm tra.');
                    keyInput.focus();
                    return;
                }

                const token = form.querySelector('input[name="__RequestVerificationToken"]')?.value;
                const body = new FormData();
                body.append('__RequestVerificationToken', token || '');
                body.append('probeProviderCode', provider.value);
                body.append('probeApiKey', keyInput.value);
                probeButton.disabled = true;
                showProbe('loading', 'Đang kiểm tra kết nối', 'Server đang xác thực trực tiếp với provider…');
                try {
                    const response = await fetch(`${window.location.pathname}?handler=ProbeCredential`, {
                        method: 'POST',
                        body,
                        cache: 'no-store',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });
                    const payload = await response.json();
                    const detail = payload.latencyMilliseconds != null
                        ? `${payload.message} Độ trễ ${Number(payload.latencyMilliseconds).toLocaleString('vi-VN')} ms${payload.providerRequestId ? ` · Request ${payload.providerRequestId}` : ''}`
                        : payload.message;
                    showProbe(payload.success ? 'success' : 'error', payload.success ? 'Key hoạt động tốt' : 'Kiểm tra chưa đạt', detail);
                } catch {
                    showProbe('error', 'Không thể hoàn tất kiểm tra', 'Phiên quản trị hoặc kết nối Server đã bị gián đoạn.');
                } finally {
                    probeButton.disabled = false;
                }
            });
        })();
    </script>
}
