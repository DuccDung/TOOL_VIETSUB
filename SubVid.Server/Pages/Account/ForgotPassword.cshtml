@page
@model SubVid.Server.Pages.Account.ForgotPasswordModel
@{
    Layout = "/Pages/Shared/_AccountAuthLayout.cshtml";
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="account-auth-grid">
    <partial name="_AccountAuthIntro" />

    <section class="account-auth-card" aria-labelledby="forgot-title">
        <div class="account-auth-heading">
            <span class="account-auth-icon" aria-hidden="true">⌁</span>
            <div><small>KHÔI PHỤC TÀI KHOẢN</small><h2 id="forgot-title">Quên mật khẩu?</h2></div>
        </div>
        <p class="account-auth-lead">Nhập email đã đăng ký. Nếu tài khoản tồn tại, SubVid sẽ gửi mã OTP để bạn tạo mật khẩu mới.</p>

        <form method="post" class="account-auth-form">
            <div asp-validation-summary="ModelOnly" class="account-validation-summary"></div>
            <label class="account-field">
                <span>Email tài khoản</span>
                <span class="account-input-wrap"><i aria-hidden="true">@@</i><input asp-for="Input.Email" type="email" autocomplete="email" placeholder="ban@example.com" autofocus /></span>
                <small><span asp-validation-for="Input.Email"></span></small>
            </label>

            <button class="account-primary-action" type="submit"><span>Gửi mã khôi phục</span><span>→</span></button>
        </form>

        <a class="account-back-link" asp-page="/Account/Login">← Quay lại đăng nhập</a>
        <div class="account-security-note"><span>◇</span> Vì lý do bảo mật, trang sẽ không tiết lộ email nào đang có tài khoản.</div>
    </section>
</div>
