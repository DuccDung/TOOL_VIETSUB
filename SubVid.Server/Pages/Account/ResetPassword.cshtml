@page
@model SubVid.Server.Pages.Account.ResetPasswordModel
@{
    Layout = "/Pages/Shared/_AccountAuthLayout.cshtml";
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<div class="account-auth-grid">
    <partial name="_AccountAuthIntro" />

    <section class="account-auth-card account-auth-card--otp" aria-labelledby="reset-title">
        <div class="account-flow-steps" aria-label="Tiến trình khôi phục">
            <span class="is-done"><i>✓</i> Email</span><b></b><span class="is-active"><i>2</i> OTP &amp; mật khẩu</span><b></b><span><i>3</i> Hoàn tất</span>
        </div>

        <div class="account-auth-heading">
            <span class="account-auth-icon" aria-hidden="true">⌁</span>
            <div><small>ĐẶT LẠI MẬT KHẨU</small><h2 id="reset-title">Tạo mật khẩu mới</h2></div>
        </div>
        <p class="account-auth-lead">Nếu email <strong>@Model.MaskedEmail</strong> thuộc một tài khoản, mã OTP đã được gửi tới hộp thư đó.</p>

        @if (TempData["OtpResent"] is string resentMessage)
        {
            <div class="account-auth-alert account-auth-alert--success"><span>✓</span><div><strong>Đã gửi mã mới</strong><small>@resentMessage</small></div></div>
        }

        <form method="post" class="account-auth-form">
            <input asp-for="ChallengeId" type="hidden" />
            <input asp-for="DeviceId" type="hidden" />
            <input asp-for="MaskedEmail" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="account-validation-summary"></div>

            <label class="account-field account-otp-field">
                <span>Mã OTP</span>
                <input asp-for="Input.Otp" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}" placeholder="000000" autofocus />
                <small><span asp-validation-for="Input.Otp"></span></small>
            </label>
            <div class="account-field-row">
                <label class="account-field">
                    <span>Mật khẩu mới</span>
                    <span class="account-input-wrap"><i aria-hidden="true">●</i><input asp-for="Input.Password" type="password" autocomplete="new-password" placeholder="Tối thiểu 8 ký tự" /></span>
                    <small><span asp-validation-for="Input.Password"></span></small>
                </label>
                <label class="account-field">
                    <span>Nhập lại mật khẩu</span>
                    <span class="account-input-wrap"><i aria-hidden="true">●</i><input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" placeholder="Nhập lại mật khẩu" /></span>
                    <small><span asp-validation-for="Input.ConfirmPassword"></span></small>
                </label>
            </div>

            <button class="account-primary-action" type="submit"><span>Đổi mật khẩu</span><span>→</span></button>
        </form>

        <form method="post" asp-page-handler="Resend" class="account-resend-form">
            <input asp-for="ChallengeId" type="hidden" />
            <input asp-for="DeviceId" type="hidden" />
            <input asp-for="MaskedEmail" type="hidden" />
            <span>Chưa nhận được email?</span>
            <button type="submit">Gửi lại mã OTP</button>
        </form>

        <a class="account-back-link" asp-page="/Account/ForgotPassword">← Nhập lại email</a>
        <div class="account-security-note"><span>✓</span> Đổi mật khẩu sẽ đăng xuất mọi phiên API và phiên web cũ.</div>
    </section>
</div>
