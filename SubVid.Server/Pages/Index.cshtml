@page
@model IndexModel
@{
    ViewData["Title"] = "SubVid — Dịch & lồng tiếng video bằng AI";
    ViewData["IsLandingPage"] = true;
}

<div class="marketing" id="top">
    <header class="landing-header">
        <nav class="landing-nav" aria-label="Điều hướng trang giới thiệu">
            <a class="landing-brand" href="#top" aria-label="SubVid - Trang chủ">
                <img class="landing-brand-logo" src="~/images/subvid-logo.png" alt="" aria-hidden="true" />
                <strong>SubVid</strong>
            </a>

            <div class="landing-links">
                <a href="#tools">Công cụ AI</a>
                <a href="#demo">Video demo</a>
                <a href="#reviews">Đánh giá</a>
                <a href="#faq">Hỏi đáp</a>
                <a class="referral-link" href="#download">
                    <span aria-hidden="true">♙</span> Giới thiệu nhận tới 20%
                </a>
            </div>

            <div class="landing-nav-actions">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="landing-account-name">Xin chào, <strong>@User.Identity.Name</strong></span>
                    <form method="post" asp-page="/Account/Logout" class="landing-logout-form">
                        <button class="login-link" type="submit">Đăng xuất</button>
                    </form>
                }
                else
                {
                    <a class="login-link" asp-page="/Account/Login">Đăng nhập</a>
                }
                <a class="nav-download" href="#download"><span aria-hidden="true">↓</span> Tải về</a>
                <details class="mobile-nav">
                    <summary aria-label="Mở menu điều hướng"><span></span><span></span><span></span></summary>
                    <div class="mobile-nav-panel">
                        <a href="#tools">Công cụ AI</a>
                        <a href="#demo">Video demo</a>
                        <a href="#reviews">Đánh giá</a>
                        <a href="#faq">Hỏi đáp</a>
                        <a class="mobile-referral" href="#download">♙ Giới thiệu nhận tới 20%</a>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form method="post" asp-page="/Account/Logout"><button type="submit">Đăng xuất @User.Identity.Name</button></form>
                        }
                        else
                        {
                            <a asp-page="/Account/Login">Đăng nhập</a>
                            <a asp-page="/Account/Register">Đăng ký miễn phí</a>
                        }
                    </div>
                </details>
            </div>
        </nav>
    </header>

    <div class="hero-zone">
        <section class="landing-hero" aria-labelledby="hero-title">
            <span class="hero-kicker">VIỆT HOÁ VIDEO TRỌN QUY TRÌNH</span>
            <h1 id="hero-title">Dịch và lồng tiếng <span>video bằng AI</span> — đúng ngữ cảnh, khớp thời lượng</h1>
            <p>SubVid có đủ mọi thứ để biến video nước ngoài thành bản Việt hoá hoàn chỉnh — tải, bóc phụ đề, dịch và lồng tiếng.</p>
            <div class="hero-actions">
                <a class="button button--primary" href="#download"><span aria-hidden="true">↓</span> Tải ngay</a>
                <a class="button button--dark" href="#tools">Xem công cụ AI</a>
            </div>
            <small>Windows 10/11 · 64-bit · macOS sắp ra mắt</small>
        </section>

        <section class="product-showcase" aria-label="Các tính năng nổi bật của SubVid">
            <input class="showcase-radio" type="radio" name="showcase" id="showcase-ocr" checked />
            <input class="showcase-radio" type="radio" name="showcase" id="showcase-translate" />
            <input class="showcase-radio" type="radio" name="showcase" id="showcase-voice" />
            <input class="showcase-radio" type="radio" name="showcase" id="showcase-clean" />
            <input class="showcase-radio" type="radio" name="showcase" id="showcase-batch" />

            <div class="showcase-grid">
                <div class="showcase-title">
                    <span>Studio chuyên nghiệp</span>
                    <strong>Việt hoá &amp;<br />lồng tiếng</strong>
                </div>

                <div class="showcase-frame">
                    <div class="showcase-screen">
                        <img class="showcase-shot shot--ocr" src="https://ezmaxsoft.com/landing-media/0730-5b2208b7947a.jpg" alt="Giao diện bóc phụ đề OCR của SubVid" />
                        <img class="showcase-shot shot--translate" src="https://ezmaxsoft.com/landing-media/dich-ngu-canh-a6a91bc5cd16.jpg" alt="Giao diện dịch theo ngữ cảnh của SubVid" loading="lazy" />
                        <img class="showcase-shot shot--voice" src="https://ezmaxsoft.com/landing-media/long-tieng-1718c37453df.jpg" alt="Giao diện lồng tiếng AI của SubVid" loading="lazy" />
                        <img class="showcase-shot shot--clean" src="https://ezmaxsoft.com/landing-media/blur-d47f45a5d9d2.jpg" alt="Giao diện xoá phụ đề cứng của SubVid" loading="lazy" />
                        <img class="showcase-shot shot--batch" src="https://ezmaxsoft.com/landing-media/batchmode-60df4ec71210.jpg" alt="Giao diện Batch Mode của SubVid" loading="lazy" />
                    </div>
                    <div class="showcase-captions" aria-live="polite">
                        <p class="caption--ocr"><strong>Thuật toán OCR tối ưu</strong> — nhận diện nhanh, ghép câu trọn nghĩa và canh đúng mốc vào/ra.</p>
                        <p class="caption--translate"><strong>Dịch theo ngữ cảnh</strong> — giữ tên riêng, xưng hô và phong cách nhất quán từ đầu đến cuối.</p>
                        <p class="caption--voice"><strong>Lồng tiếng AI đa nhân vật</strong> — mỗi nhân vật một giọng, tự cân chỉnh theo thời lượng câu thoại.</p>
                        <p class="caption--clean"><strong>Xoá phụ đề cứng</strong> — chọn vùng xử lý trực quan, làm sạch khung hình trước khi ghép sub mới.</p>
                        <p class="caption--batch"><strong>Batch Mode</strong> — xếp hàng nhiều video và chạy trọn quy trình với ít thao tác hơn.</p>
                    </div>
                </div>

                <div class="showcase-tabs" role="tablist" aria-label="Chọn tính năng xem trước">
                    <label for="showcase-ocr">Bóc phụ đề OCR <span>✦</span></label>
                    <label for="showcase-translate">Dịch theo ngữ cảnh</label>
                    <label for="showcase-voice">Lồng tiếng AI</label>
                    <label for="showcase-clean">Xoá sub cứng</label>
                    <label for="showcase-batch">Batch Mode</label>
                </div>
            </div>
        </section>

        <section class="platforms" aria-label="Các nền tảng được hỗ trợ">
            <p>TẢI VIDEO TRỰC TIẾP TỪ 1.800+ NỀN TẢNG</p>
            <div class="platform-marquee">
                <div class="platform-track">
                    <span>YouTube</span><span>Bilibili</span><span>iQIYI</span><span>Youku</span><span>Douyin</span><span>TikTok</span><span>WeTV</span><span>Instagram</span><span>Facebook</span><span>X</span><span>Vimeo</span>
                    <span aria-hidden="true">YouTube</span><span aria-hidden="true">Bilibili</span><span aria-hidden="true">iQIYI</span><span aria-hidden="true">Youku</span><span aria-hidden="true">Douyin</span><span aria-hidden="true">TikTok</span><span aria-hidden="true">WeTV</span><span aria-hidden="true">Instagram</span><span aria-hidden="true">Facebook</span><span aria-hidden="true">X</span><span aria-hidden="true">Vimeo</span>
                </div>
            </div>
        </section>
    </div>

    <section class="tools-section section-wrap" id="tools" aria-labelledby="tools-title">
        <div class="section-heading section-heading--split">
            <div>
                <span>TOÀN BỘ QUY TRÌNH TRONG MỘT ỨNG DỤNG</span>
                <h2 id="tools-title">Công cụ Việt hoá AI</h2>
                <p>Năm bước liền mạch — từ video gốc đến bản Việt hoá có phụ đề và giọng đọc hoàn chỉnh.</p>
            </div>
            <a class="text-pill" href="#download">Tải ngay <span>↗</span></a>
        </div>

        <div class="tool-list">
            <article class="tool-feature tool-feature--active">
                <div class="tool-number">01</div>
                <div class="tool-copy">
                    <span class="tool-icon" aria-hidden="true">↓</span>
                    <h3>Tải video</h3>
                    <p>Dán liên kết từ hơn 1.800 nền tảng hoặc chọn video có sẵn trên máy. Tự nhận diện danh sách phát và chất lượng nguồn.</p>
                    <div class="feature-tags"><span>Quét playlist</span><span>Chọn chất lượng</span><span>Tải hàng loạt</span></div>
                </div>
                <div class="tool-visual" aria-hidden="true">
                    <div class="url-field"><span>youtube.com/watch?v=...</span><b>Phân tích</b></div>
                    <div class="download-row"><i></i><span><strong>video-phim-ngan.mp4</strong><small>1080p · 124 MB</small></span><em>92%</em></div>
                    <div class="download-row"><i></i><span><strong>tap-02.mp4</strong><small>1080p · 98 MB</small></span><em>Chờ</em></div>
                </div>
            </article>

            <article class="tool-feature">
                <div class="tool-number">02</div>
                <div class="tool-copy"><h3>Bóc phụ đề</h3><p>OCR hoặc nhận dạng lời thoại, tự ghép các khung chữ thành câu hoàn chỉnh.</p></div>
                <span class="tool-more" aria-hidden="true">+</span>
            </article>
            <article class="tool-feature">
                <div class="tool-number">03</div>
                <div class="tool-copy"><h3>Dịch thuật</h3><p>Dịch theo toàn cảnh, bảo toàn tên riêng và cách xưng hô của từng nhân vật.</p></div>
                <span class="tool-more" aria-hidden="true">+</span>
            </article>
            <article class="tool-feature">
                <div class="tool-number">04</div>
                <div class="tool-copy"><h3>Lồng tiếng AI</h3><p>Phân vai nhiều giọng đọc, khớp tốc độ và thời lượng từng đoạn thoại.</p></div>
                <span class="tool-more" aria-hidden="true">+</span>
            </article>
            <article class="tool-feature">
                <div class="tool-number">05</div>
                <div class="tool-copy"><h3>Xoá sub &amp; xuất video</h3><p>Làm sạch phụ đề cứng, chỉnh timeline và xuất bản video hoàn chỉnh.</p></div>
                <span class="tool-more" aria-hidden="true">+</span>
            </article>
        </div>
    </section>

    <section class="demo-section section-wrap" id="demo" aria-labelledby="demo-title">
        <div class="section-heading section-heading--center">
            <span>THẤY TOÀN BỘ TRƯỚC KHI BẮT ĐẦU</span>
            <h2 id="demo-title">Xem trọn quy trình trên SubVid</h2>
            <p>Một video được tải, tạo phụ đề, dịch, lồng tiếng và xuất bản ngay trong cùng một workspace.</p>
        </div>
        <button class="demo-player" type="button" aria-label="Phát video giới thiệu SubVid">
            <img src="https://ezmaxsoft.com/landing-media/demo-poster-cfdd52edb7eb.jpg" alt="Màn hình chọn dự án của SubVid" loading="lazy" />
            <span class="demo-play"><i></i></span>
            <span class="demo-duration">02:18</span>
        </button>
        <div class="stats-grid" aria-label="Thông số nổi bật">
            <div><strong>1.800+</strong><span>Nền tảng tải video</span></div>
            <div><strong>46+</strong><span>Ngôn ngữ OCR</span></div>
            <div><strong>13+</strong><span>Engine giọng đọc</span></div>
        </div>
    </section>

    <section class="reviews-section section-wrap" id="reviews" aria-labelledby="reviews-title">
        <div class="section-heading section-heading--split">
            <div>
                <span>TRẢI NGHIỆM TỪ NGƯỜI DÙNG THỰC TẾ</span>
                <h2 id="reviews-title">Người dùng nói gì</h2>
                <p>Những phản hồi ngắn gọn từ người làm nội dung và vận hành kênh video.</p>
            </div>
            <a class="text-pill text-pill--dark" href="#download">Trải nghiệm <span>↗</span></a>
        </div>
        <div class="review-grid">
            <article class="review-card review-card--green">
                <div class="review-stars">★★★★★</div>
                <p>“Batch mode giúp mình xử lý cả danh sách video qua đêm, sáng chỉ việc kiểm tra và xuất bản.”</p>
                <footer><span>HN</span><div><strong>Hoàng Nam</strong><small>Quản trị kênh phim</small></div></footer>
            </article>
            <article class="review-card review-card--gold">
                <div class="review-stars">★★★★★</div>
                <p>“OCR nhận chữ Trung rất ổn, phần ghép câu đỡ cho mình rất nhiều thời gian chỉnh thủ công.”</p>
                <footer><span>MT</span><div><strong>Minh Tú</strong><small>Biên tập video</small></div></footer>
            </article>
            <article class="review-card review-card--orange">
                <div class="review-stars">★★★★★</div>
                <p>“Điểm mình thích nhất là dịch theo ngữ cảnh, tên và cách xưng hô không bị đổi liên tục.”</p>
                <footer><span>PL</span><div><strong>Phương Linh</strong><small>Nhà sáng tạo nội dung</small></div></footer>
            </article>
            <article class="review-card review-card--coral">
                <div class="review-stars">★★★★★</div>
                <p>“Từ sub đến giọng đọc nằm chung một timeline nên quy trình dễ hiểu, không phải đổi nhiều phần mềm.”</p>
                <footer><span>DK</span><div><strong>Đăng Khoa</strong><small>Freelance editor</small></div></footer>
            </article>
        </div>
    </section>

    <section class="faq-section section-wrap" id="faq" aria-labelledby="faq-title">
        <div class="section-heading section-heading--center">
            <span>NHỮNG ĐIỀU BẠN CÓ THỂ ĐANG QUAN TÂM</span>
            <h2 id="faq-title">Câu hỏi thường gặp</h2>
        </div>
        <div class="faq-list">
            <details open>
                <summary>SubVid dùng để làm gì?<span>+</span></summary>
                <p>SubVid hỗ trợ tải video, nhận dạng hoặc bóc phụ đề, dịch theo ngữ cảnh, tạo giọng đọc và xuất thành video Việt hoá hoàn chỉnh.</p>
            </details>
            <details>
                <summary>SubVid chạy trên máy nào?<span>+</span></summary>
                <p>Phiên bản hiện tại được thiết kế cho Windows 10/11 64-bit. Giao diện luôn hiển thị yêu cầu cấu hình trước khi người dùng tải xuống.</p>
            </details>
            <details>
                <summary>Ứng dụng có hỗ trợ nhiều người nói không?<span>+</span></summary>
                <p>Có. Luồng thiết kế cho phép nhận diện nhiều nhân vật và gán một giọng đọc riêng cho từng người.</p>
            </details>
            <details>
                <summary>Tôi được chọn dịch bằng model nào?<span>+</span></summary>
                <p>Bạn có thể chọn model cloud phù hợp hoặc dùng model local khi đã cài đặt. Cấu hình cụ thể sẽ được nối ở giai đoạn chức năng.</p>
            </details>
            <details>
                <summary>Có cần kết nối Internet không?<span>+</span></summary>
                <p>Một số tác vụ local có thể chạy trên máy; tải video, model cloud và đồng bộ tài khoản vẫn cần Internet.</p>
            </details>
        </div>
    </section>

    <section class="download-section" id="download" aria-labelledby="download-title">
        <div class="section-wrap">
            <div class="section-heading section-heading--center">
                <span>BẮT ĐẦU VIỆT HOÁ VIDEO CỦA BẠN</span>
                <h2 id="download-title">Tải SubVid</h2>
                <p>Cài trong vài phút, chạy ngay trên máy của bạn. Phiên bản mới nhất dành cho Windows 64-bit.</p>
            </div>
            <div class="download-grid">
                <article class="download-card download-card--available">
                    <div class="platform-icon" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
                    <div><strong>Windows</strong><small>Windows 10/11 · 64-bit</small></div>
                    <p>Đầy đủ công cụ tạo phụ đề, dịch và lồng tiếng AI.</p>
                    <a class="button button--primary" href="#download"><span aria-hidden="true">↓</span> Tải xuống</a>
                    <em>Phiên bản giao diện thử nghiệm</em>
                </article>
                <article class="download-card download-card--soon">
                    <div class="apple-icon" aria-hidden="true">●</div>
                    <div><strong>macOS</strong><small>Apple Silicon &amp; Intel</small></div>
                    <p>Đang được tối ưu để mang lại trải nghiệm đồng nhất.</p>
                    <button class="button button--disabled" type="button" disabled>Sắp ra mắt</button>
                    <em>Nhận thông báo khi phát hành</em>
                </article>
            </div>
        </div>
    </section>

    <footer class="landing-footer">
        <div class="section-wrap footer-grid">
            <div class="footer-about">
                <a class="landing-brand" href="#top"><img class="landing-brand-logo" src="~/images/subvid-logo.png" alt="" aria-hidden="true" /><strong>SubVid</strong></a>
                <p>Phần mềm Việt hoá video bằng AI — từ phụ đề đến giọng đọc, trong một quy trình liền mạch.</p>
            </div>
            <div><strong>Sản phẩm</strong><a href="#tools">Công cụ AI</a><a href="#demo">Video demo</a><a href="#download">Tải ứng dụng</a></div>
            <div><strong>Tài nguyên</strong><a href="#faq">Câu hỏi thường gặp</a><a href="#reviews">Đánh giá</a><a href="/openapi/v1.json">Tài liệu API</a></div>
            <div><strong>Hỗ trợ</strong><a href="mailto:nestg.support@gmail.com">nestg.support@gmail.com</a><a href="#faq">Trung tâm trợ giúp</a><a asp-page="/Privacy">Chính sách riêng tư</a></div>
        </div>
        <div class="footer-wordmark">SubVid</div>
        <div class="footer-bottom section-wrap"><span>© 2026 SubVid. All rights reserved.</span><span>Thiết kế cho trải nghiệm Việt hoá video.</span></div>
    </footer>

    <div class="floating-contact" aria-label="Liên hệ hỗ trợ nhanh">
        <a href="#faq" aria-label="Mở trợ giúp">?</a>
        <a href="mailto:nestg.support@gmail.com" aria-label="Gửi email hỗ trợ">✉</a>
    </div>
</div>
